# PodcastBox. Copy to .env only if you run the API outside Docker.
# Docker Compose sets these itself.

INBOX_BRIEF_OLLAMA_URL=http://127.0.0.1:11434
INBOX_BRIEF_DIA_URL=http://127.0.0.1:8871
INBOX_BRIEF_SPEACHES_URL=http://127.0.0.1:8969
INBOX_BRIEF_DATA_DIR=./data
INBOX_BRIEF_KOKORO_MODEL=./models/kokoro/kokoro-v1.0.onnx
INBOX_BRIEF_KOKORO_VOICES=./models/kokoro/voices-v1.0.bin
# Accent and voice ids are stored settings, not environment variables.
# Default: British English, Kokoro lang code b, voices bf_emma and bm_george.

# OAuth. Leave blank until you create the apps described in the README.
INBOX_BRIEF_GOOGLE_CLIENT_ID=
INBOX_BRIEF_GOOGLE_CLIENT_SECRET=
INBOX_BRIEF_GOOGLE_REDIRECT_URI=http://127.0.0.1:8742/api/connect/gmail/callback
INBOX_BRIEF_MICROSOFT_CLIENT_ID=
INBOX_BRIEF_MICROSOFT_CLIENT_SECRET=
INBOX_BRIEF_MICROSOFT_TENANT=common
INBOX_BRIEF_MICROSOFT_REDIRECT_URI=http://127.0.0.1:8742/api/connect/outlook/callback
INBOX_BRIEF_WEB_URL=http://127.0.0.1:43123
